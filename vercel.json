{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/login", "dest": "/server.js" },
    { "src": "/panel", "dest": "/server.js" },
    { "src": "/", "dest": "/server.js" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}